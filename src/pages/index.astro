---
import Layout from '@layouts/Layout.astro'
---

<Layout title="Astro Starter" description="A minimal Astro Starter template.">
  <main>
    <section class="px-page">
      <div class="contained py-section-sm">
        <h1 class="mb-3 text-2xl">
          Use this as a starting point for your projects.
        </h1>
        <p class="mb-2 text-lg">
          This template includes the following technologies:
        </p>
        <ul class="list-inside list-disc space-y-2">
          <li>
            [Astro]<a
              href="https://astro.build/"
              class="text-primary-600 hover:text-primary-500 underline"
              >(https://astro.build/)</a
            >
          </li>
          <li>
            [Astro SEO]<a
              href="https://github.com/brillout/astro-seo"
              class="text-primary-600 hover:text-primary-500 underline"
              >(https://github.com/brillout/astro-seo)</a
            >
          </li>
          <li>
            [TailwindCSS]<a
              href="https://tailwindcss.com/"
              class="text-primary-600 hover:text-primary-500 underline"
              >(https://tailwindcss.com/)</a
            >
          </li>
          <li>
            [Tailwind Variants]<a
              href="https://www.tailwind-variants.org/docs/getting-started"
              class="text-primary-600 hover:text-primary-500 underline"
              >(https://www.tailwind-variants.org/docs/getting-started)</a
            >
          </li>
          <li>
            [Prettier]<a
              href="https://prettier.io/"
              class="text-primary-600 hover:text-primary-500 underline"
              >(https://prettier.io/)</a
            >
          </li>
          <li>
            [TypeScript]<a
              href="https://www.typescriptlang.org/"
              class="text-primary-600 hover:text-primary-500 underline"
              >(https://www.typescriptlang.org/)</a
            >
          </li>
        </ul>
      </div>
    </section>
  </main>
</Layout>
