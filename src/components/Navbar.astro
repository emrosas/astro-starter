---
import Button from '@components/Button.astro'
import Favicon from '@svgs/favicon.svg'
---

<div class="px-page">
  <nav class="gap-gutter contained flex items-center justify-between py-4">
    <a
      href="/"
      class="bg-primary-500 rounded-md p-4 py-2 text-2xl font-medium text-white"
      ><Favicon class="mr-1 inline size-10" /> Astro Starter</a
    >
    <ul
      id="menu"
      class="p-page fixed top-1/2 right-4 hidden rounded-xl border border-neutral-950/15 bg-white data-open:block"
    >
      <li>First</li>
      <li>Second</li>
      <li>Third</li>
    </ul>
    <Button aria-expanded="false" aria-controls="menu" id="menu-button"
      >Open Menu</Button
    >
  </nav>
</div>
